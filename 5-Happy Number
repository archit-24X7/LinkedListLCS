import java.util.*;

class Solution {
    public boolean isHappy(int n) {

        int slow = n;
        int fast = n;

        do{
          slow = remSq(slow);
          fast = remSq(remSq(fast));
        }while(slow != fast);

        if(slow == 1)
        {
            return true;
        }

        return false;
    }

    public int remSq(int n)
    {
        int sum = 0;

        while(n > 0)
        {
            int rem = n % 10;
                sum += rem * rem;
                n   /= 10;
        }
        return sum;
    }
}
