class Solution {
    public ListNode reverseBetween(ListNode head, int left, int right) {

        if(left == right)
        {
            return head;
        }
        
        ListNode current = head;
        ListNode prev = null;

        // left - 1 is a position where our linked list will remain same

        for(int i = 0; i < left - 1 && current != null; i++)
        {
            prev = current;
            current = current.next;
        }

        ListNode newNode = current;  
        ListNode last = prev;

        // 
        ListNode next = current.next;

        for(int i = 0; i < (right - left + 1) && current != null; i++)
        {
            current.next = prev;
            prev = current;
            current = next;
            if(next != null)
            {
                next = next.next;
            }
        }

        if(last != null)
        {
            last.next = prev;
        }
        else
        {
            head = prev;
        }
        newNode.next = current;
        return head;
    }
}
