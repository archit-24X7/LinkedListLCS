 class Solution {
    public ListNode deleteDuplicates(ListNode head) {
        ListNode t = head;
       //  ListNode temp = head;
        int count = 0;

        if(t == null)
        {
            return t;
        }

        // while (temp != null) 
        // {
        //     count++;
        //     temp = temp.next;
        // }

        while(t != null && t.next != null)
        {
            if(t.val == t.next.val)
            {
                t.next = t.next.next;
                count--;
            }
            else
            { 
                t = t.next; 
            }
        }

        // if((count == 2) && (head == head.next))
        // {
        //     head.next = head.next.next;
        // }
        return head;
    }
}
