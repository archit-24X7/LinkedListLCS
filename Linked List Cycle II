public class Solution {
    public ListNode detectCycle(ListNode head) {

        int length = 0;

        ListNode fast = head;
        ListNode slow = head;

        while(fast != null && fast.next != null)
        {
            slow = slow.next;
            fast = fast.next.next;

            if(slow == fast)
            {
                length = lengthCycle(slow);
                break;
            }
        }
            if(length == 0)
            {
                return null;
            }

            ListNode first = head;
            ListNode second = head;

            while(length > 0)
            {
                second = second.next;
                length--; 
            }

            while(first != second)
            {
                first = first.next;
                second = second.next;
            }

        return second;
    }

    private int lengthCycle(ListNode head)
    {
        int length = 0;
        ListNode temp = head;
        do{
            temp = temp.next;
            length++;
        }while(temp != head);

        return length;
    }  
}
