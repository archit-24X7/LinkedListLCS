class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode newNode = head;
        ListNode current = head;
        ListNode previous = null;

        while(current != null)
        {
            newNode = current.next;
            current.next = previous;
            previous = current;
            current = newNode; 
        } 
        return previous; 
    }
}
